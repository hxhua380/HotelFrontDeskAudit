{
  "name": "hotel-front-desk-audit",
  "version": "0.1.0",
  "private": true,
  "description": "酒店前台订单与录音核对演示（合成数据与 AI 语音）",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke-pi.ts",
    "generate:data": "tsx scripts/generate-demo-data.ts",
    "generate:audio": ".venv-audio\\Scripts\\python.exe scripts/generate-audio.py",
    "validate:data": "tsx scripts/validate-demo-data.ts",
    "test:audio": ".venv-audio\\Scripts\\python.exe scripts/generate-audio.py --self-test",
    "audit": "tsx scripts/audit-day.ts",
    "agent": "tsx scripts/audit-agent.ts",
    "smoke:audit": "tsx scripts/smoke-audit-pi.ts",
    "dev": "tsx src/web/server.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
